<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Public Entries</title>
</head>
<body>
    <%- include('./partials/navbar') %>

    <h1>All Public Entries</h1>

    <ul>
        <% for (let entry of entries) { %>
            <li>
                <h2><%= entry.title %></h2>
                <p><%= entry.entryBody %></p>
            </li>
        <% } %>
    </ul>
</body>
</html>
